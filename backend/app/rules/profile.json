{
  "type": "object",
  "properties": {
    "given_name": { "$ref": "#/$defs/personName" },
    "family_name": { "$ref": "#/$defs/personName" },
    "middle_name": { "$ref": "#/$defs/personName" },
    "mobile_number": { "type": "string", "maxLength": 32 },
    "address": {
      "type": "object",
      "properties": {
        "line1": { "type": "string", "maxLength": 255 },
