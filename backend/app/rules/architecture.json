{
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": {
      "$ref": "#/$defs/identifier",
      "minLength": 1,
      "pattern": "\\S",
      "unique": "provider"
    },
    "description": { "type": "string" },
    "default_box": { "type": "boolean" },
    "checksum_type": {
      "type": "string",
      "enum": ["NULL", "MD5", "SHA1", "SHA256", "SHA384", "SHA512"]
    },
    "checksum": { "$ref": "#/$defs/hex" }
  }
}
