{
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": { "$ref": "#/$defs/slug", "minLength": 1, "pattern": "\\S", "unique": "organization" },
    "description": { "type": "string" },
    "details": { "type": "string" },
    "is_public": { "type": "boolean" },
    "published": { "type": "boolean" },
    "guest_access": { "type": "boolean" },
    "recursive": { "type": "boolean" },
    "family": { "type": "string" },
    "vendor": { "type": "string" },
    "docs_url": { "type": "string", "format": "uri" },
    "notes_url": { "type": "string", "format": "uri" },
    "icon_url": { "type": "string", "format": "uri" }
  }
}
