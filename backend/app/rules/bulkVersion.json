{
  "type": "object",
  "required": ["action", "names"],
  "properties": {
    "action": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "enum": [
        "delete",
        "deprecate",
        "set",
        "move",
        "reconcile",
        "make_public",
        "make_private",
        "publish",
        "unpublish",
        "allow_guests",
        "deny_guests"
      ]
    },
    "names": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "deprecation_reason": { "type": "string", "maxLength": 512 },
    "recursive": { "type": "boolean" },
    "download": { "$ref": "#/$defs/slug" },
    "values": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "release_notes": { "type": "string" }
      }
    }
  },
  "if": { "properties": { "action": { "const": "deprecate" } }, "required": ["action"] },
  "then": { "required": ["deprecation_reason"] }
}
