{
  "type": "object",
  "required": ["action", "names"],
  "properties": {
    "action": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "enum": ["delete", "deprecate"]
    },
    "names": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "deprecation_reason": { "type": "string", "maxLength": 512 }
  },
  "if": { "properties": { "action": { "const": "deprecate" } }, "required": ["action"] },
  "then": { "required": ["deprecation_reason"] }
}
