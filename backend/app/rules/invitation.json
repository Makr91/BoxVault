{
  "type": "object",
  "required": ["email", "organization_name"],
  "properties": {
    "email": { "$ref": "#/$defs/email", "minLength": 1 },
    "organization_name": { "$ref": "#/$defs/slug", "minLength": 1, "pattern": "\\S" },
    "invite_role": { "type": "string", "enum": ["member", "admin"] }
  }
}
