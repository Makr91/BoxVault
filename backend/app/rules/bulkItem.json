{
  "type": "object",
  "required": ["action", "names"],
  "properties": {
    "action": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "enum": [
        "delete",
        "make_public",
        "make_private",
        "publish",
        "unpublish",
        "allow_guests",
        "deny_guests"
      ]
    },
    "names": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
