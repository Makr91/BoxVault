{
  "type": "object",
  "required": ["key"],
  "properties": {
    "key": { "$ref": "#/$defs/identifier", "minLength": 1, "pattern": "\\S", "unique": "patch" },
    "file_name": { "type": "string" },
    "download": { "$ref": "#/$defs/slug" },
    "release": { "$ref": "#/$defs/identifier" },
    "patch": { "$ref": "#/$defs/identifier" },
    "kind": {
      "type": "string",
      "enum": [
        "installer",
        "fixpack",
        "hotfix",
        "interim-fix",
        "container-image",
        "package",
        "template",
        "notes",
        "tool",
        "link",
        "other"
      ]
    },
    "platform": {
      "type": "string",
      "enum": ["linux", "windows", "macos", "omnios", "other", "any"]
    },
    "architecture": { "type": "string", "enum": ["x64", "x86", "arm64", "other", "any"] },
    "language": { "$ref": "#/$defs/languageTag" },
    "variant": { "type": "string" },
    "source_url": { "type": "string", "format": "uri" },
    "checksum_type": {
      "type": "string",
      "enum": ["NULL", "MD5", "SHA1", "SHA256", "SHA384", "SHA512"]
    },
    "checksum": { "$ref": "#/$defs/hex" },
    "is_public": { "type": "boolean" },
    "guest_access": { "type": "boolean" },
    "published": { "type": "boolean" }
  }
}
