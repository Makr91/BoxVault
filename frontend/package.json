{
  "name": "boxvault-frontend",
  "version": "0.71.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@vitejs/plugin-react": "^6.0.1",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "loglevel": "^1.9.2",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.8",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.2",
    "vite": "^8.2.2",
    "vite-plugin-svgr": "^5.0.0"
  },
  "scripts": {
    "start": "vite",
    "cinstall": "npm ci",
    "cinstall:nodev": "npm ci --omit=dev",
    "build": "vite build --emptyOutDir",
    "preview": "vite preview",
    "watch-build": "vite build --emptyOutDir --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "quality": "npm run lint && npm run format:check",
    "fix": "npm run lint:fix && npm run format:fix",
    "security:audit": "better-npm-audit audit",
    "security:vulnerabilities": "better-npm-audit audit",
    "security:licenses": "license-checker-rseidelsohn --onlyAllow 'MIT;Apache-2.0;BSD;BSD-2-Clause;BSD-3-Clause;ISC;GPL-3.0;LGPL-2.1;LGPL-3.0;MPL-2.0;CC0-1.0;CC-BY-3.0;CC-BY-4.0;Unlicense;Python-2.0;Unicode-DFS-2016;Apache 2.0;BlueOak-1.0.0' --excludePrivatePackages",
    "security:supply-chain": "audit-ci --moderate --allowlist GHSA-qwww-vcr4-c8h2",
    "security:all": "npm run security:audit && npm run security:vulnerabilities && npm run security:licenses && npm run security:supply-chain"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "audit-ci": "^7.1.0",
    "better-npm-audit": "^3.11.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "prettier": "^3.9.6"
  }
}
