#!/bin/bash
set -e

# Stop and disable service before removal
if systemctl is-active --quiet boxvault; then
    echo "Stopping BoxVault service..."
    systemctl stop boxvault
fi

if systemctl is-enabled --quiet boxvault; then
    echo "Disabling BoxVault service..."
    systemctl disable boxvault
fi

if [ "$1" = "remove" ] && systemctl is-enabled --quiet boxvault-update.path; then
    echo "Disabling BoxVault update watch..."
    systemctl disable --now boxvault-update.path
fi

#DEBHELPER#
